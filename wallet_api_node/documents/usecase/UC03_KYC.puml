@startuml UC03_KYC
left to right direction
skinparam usecase {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

actor "Admin" as Admin

rectangle "Phân hệ: Xác minh KYC" {
    usecase "Xem danh sách hồ sơ KYC\n(Lọc theo trạng thái)" as UC1
    usecase "Xem chi tiết hồ sơ KYC\n(Ảnh CCCD mặt trước/sau)" as UC2
    usecase "Duyệt hồ sơ KYC" as UC3
    usecase "Từ chối hồ sơ KYC" as UC4
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4

UC3 .up.> UC2 : <<extend>>
UC4 .up.> UC2 : <<extend>>

@enduml
