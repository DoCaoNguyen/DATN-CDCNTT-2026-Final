@startuml UC04_ViDienTu
left to right direction
skinparam usecase {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

actor "Admin" as Admin

rectangle "Phân hệ: Quản lý Ví điện tử" {
    usecase "Xem danh sách ví\n(Tìm kiếm theo SĐT, tên, số ví)" as UC1
    usecase "Xem chi tiết ví\n(Tổng nạp/rút, số dư)" as UC2
    usecase "Xem lịch sử biến động số dư\n(Wallet Ledger)" as UC3
    usecase "Khóa ví\n(Kèm lý do bắt buộc)" as UC4
    usecase "Mở khóa ví" as UC5
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5

UC3 ..> UC2 : <<include>>\nXem trong trang chi tiết
UC4 .up.> UC1 : <<extend>>\nTừ danh sách ví
UC5 .up.> UC1 : <<extend>>\nTừ danh sách ví

@enduml
