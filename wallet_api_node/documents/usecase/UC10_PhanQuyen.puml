@startuml UC09_HeThong
left to right direction
skinparam usecase {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

actor "Admin" as Admin

rectangle "Phân hệ: Phân quyền, Cấu hình & Logs" {
    usecase "Xem danh sách Role" as UC1
    usecase "Tạo Role mới\n(Chọn permissions từ ma trận)" as UC2
    usecase "Sửa Role\n(Cập nhật tên, mô tả, quyền)" as UC3
    usecase "Xóa Role" as UC4
    usecase "Xem danh sách cấu hình hệ thống\n(Phí, hạn mức)" as UC5
    usecase "Cập nhật giá trị cấu hình" as UC6
    usecase "Xem lịch sử thay đổi cấu hình" as UC7
    usecase "Xem Logs hệ thống\n(API / Payment / System\nWebhook / Audit)" as UC8
    usecase "Xem chi tiết Log\n(Request/Response JSON)" as UC9
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9

UC6 ..> UC7 : <<include>>\nTự động lưu lịch sử
UC9 .up.> UC8 : <<extend>>\nMở modal chi tiết

@enduml
