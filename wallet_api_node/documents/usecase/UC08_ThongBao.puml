@startuml UC07_Webhook
left to right direction
skinparam usecase {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

actor "Admin" as Admin

rectangle "Phân hệ: Quản lý Webhooks" {
    usecase "Xem DS Webhook/Callback\n(Lọc theo trạng thái)" as UC1
    usecase "Xem chi tiết Webhook\n(Request/Response body)" as UC2
    usecase "Retry gửi lại Webhook\n(Gửi lại callback thất bại)" as UC3
}

Admin --> UC1
Admin --> UC2
Admin --> UC3

UC3 .up.> UC2 : <<extend>>\nRetry từ modal chi tiết

@enduml
